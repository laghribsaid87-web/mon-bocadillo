{
  "name": "mon-bocadillo",
  "description": "Caisse Mon Bocadillo Management Application",
  "author": "Mon Bocadillo",
  "private": true,
  "version": "1.0.62",
  "type": "module",
  "main": "public/electron.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy:firebase": "npm run build && firebase deploy",
    "build:web": "vite build",
    "build:apk-client": "cross-env VITE_APP_TYPE=CLIENT vite build",
    "build:apk-driver": "cross-env VITE_APP_TYPE=DRIVER vite build",
    "electron:dev": "cross-env ELECTRON_START_URL=http://localhost:5173 electron .",
    "app": "concurrently \"npm run dev\" \"npm run electron:dev\"",
    "dist": "npm run build && electron-builder",
    "build:32": "npm run build && electron-builder --win --ia32",
    "build:64": "npm run build && electron-builder --win --x64",
    "build:exe": "npm run build && electron-builder --win --x64 --ia32",
    "build:apk": "npm run deploy:apk-sync && cd android && gradlew assembleDebug",
    "publish:win": "npm run build && electron-builder --win --x64 -p always && electron-builder --win --ia32 -p always",
    "deploy:update": "npm version patch --force && npm run publish:win",
    "deploy:apk-sync": "npm run build:apk-driver && npx cap sync android",
    "deploy:all": "npm version patch --force && npm run deploy:apk-sync && npm run build && firebase deploy && git add . && git commit -m \"Mise a jour globale (Web, APK, EXE via Github)\" && git push",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/app": "^8.1.0",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/push-notifications": "^8.0.4",
    "@google/generative-ai": "^0.24.1",
    "electron-updater": "^6.8.3",
    "react-router-dom": "^7.18.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/core": "^8.3.3",
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^22.3.27",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase": "^12.12.0",
    "firebase-tools": "^13.11.2",
    "framer-motion": "^12.38.0",
    "globals": "^17.4.0",
    "leaflet": "^1.9.4",
    "leaflet-routing-machine": "^3.2.12",
    "lucide-react": "^1.8.0",
    "postcss": "^8.5.10",
    "qz-tray": "^2.2.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.4",
    "vite-plugin-compression": "^0.5.1"
  },
  "build": {
    "appId": "com.monbocadillo.caisse",
    "productName": "Caisse Mon Bocadillo",
    "artifactName": "${productName} Setup ${arch}.${ext}",
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraMetadata": {
      "main": "dist/electron.cjs"
    },
    "win": {
      "icon": "public/logo.png",
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "laghribsaid87-web",
        "repo": "mon-bocadillo"
      }
    ],
    "generateUpdatesFilesForAllChannels": true
  }
}
