rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Protect the configuration and menu from public modification
    match /artifacts/{appId}/public/data/settings/{settingDoc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // General rule for the rest of the app (Orders, Clients, etc.)
    match /{document=**} {
      allow read, create, update: if true;
      // Prevent unauthorized deletion of any document
      allow delete: if request.auth != null;
    }
  }
}